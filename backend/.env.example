# Backend environment variables.
# Copy this file to .env (same folder) and adjust the values:
#     cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# Required. Generate a fresh key with:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Keep the single quotes: generated keys can contain characters such as $ and #
# that python-dotenv would otherwise try to interpret.
DJANGO_SECRET_KEY='replace-me-with-a-generated-secret-key'

# True for local development only. Shows detailed error pages.
DJANGO_DEBUG=True

# Comma-separated host names this server answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed to call the API (the React dev server).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
