# Frontend environment variables.
# Copy this file to .env (same folder):
#     cp .env.example .env
# Restart `npm run dev` after changing it: Vite reads .env only at startup.
#
# Only variables starting with VITE_ are exposed to browser code
# (as import.meta.env.VITE_...). Everything here ends up in the JavaScript
# sent to users, so never put secrets in this file.

# Base URL of the Django API, without a trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
